         &bt BT_CLR_ALL  &bt BT_CLR      &sys_reset      &bootloader     &studio_unlock             &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_BRD &rgb_ug RGB_BRI &rgb_ug RGB_TOG
