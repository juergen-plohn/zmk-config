// Leader key sequences.
// Usage: press LEADER (RH2), then a top-row key to output the corresponding F-key.
// With a modifier held beforehand (e.g. hold T for LCTRL on Colemak), the F-key fires with that modifier.
//
//  Top row (left→right):  Q W F P B | J L U Y '  →  F1–F10
//  Bottom row:            Z X                      →  F11 F12

&leader {
    ldr_f1  { sequence = <Q>;   bindings = <&kp F1>;  };
    ldr_f2  { sequence = <W>;   bindings = <&kp F2>;  };
    ldr_f3  { sequence = <F>;   bindings = <&kp F3>;  };
    ldr_f4  { sequence = <P>;   bindings = <&kp F4>;  };
    ldr_f5  { sequence = <B>;   bindings = <&kp F5>;  };
    ldr_f6  { sequence = <J>;   bindings = <&kp F6>;  };
    ldr_f7  { sequence = <L>;   bindings = <&kp F7>;  };
    ldr_f8  { sequence = <U>;   bindings = <&kp F8>;  };
    ldr_f9  { sequence = <Y>;   bindings = <&kp F9>;  };
    ldr_f10 { sequence = <SQT>; bindings = <&kp F10>; };
    ldr_f11 { sequence = <Z>;   bindings = <&kp F11>; };
    ldr_f12 { sequence = <X>;   bindings = <&kp F12>; };
};
